# ============================================
# ForgeAI - Environment Configuration
# ============================================
# Copy this file to .env and fill in your API keys

# Choose your LLM provider (groq / gemini)
LLM_PROVIDER=groq

# Groq API Key (Free tier - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Free tier - https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Model Configuration
# Groq models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
# Gemini models: gemini-3.8-flash, gemini-2.5-flash
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Budget Configuration (Stretch Goal)
MAX_TOKENS_PER_RUN=500000
MAX_ITERATIONS=3
